# Example environment variables for Authentik integration
# Copy this to .env and adjust the values

# ============================================
# Authentik Configuration
# ============================================

# Secret key for Authentik (generate with: openssl rand -hex 32)
AUTHENTIK_SECRET_KEY=changeme-generate-a-random-key-in-production

# Initial admin password (first-time setup only)
AUTHENTIK_BOOTSTRAP_PASSWORD=admin

# Optional: Bootstrap API token (if you want a known token)
# AUTHENTIK_BOOTSTRAP_TOKEN=your-token-here

# Database password for Authentik's PostgreSQL
AUTHENTIK_DB_PASSWORD=authentik

# Port for Authentik web interface (default: 9000)
HIVEKEEPER_AUTHENTIK_PORT=9000

# ============================================
# HiveKeeper Gateway - Authentik Integration
# ============================================

# Authentik API token (create in Authentik admin panel)
# Required for the gateway to create users
HIVEKEEPER_AUTHENTIK_API_TOKEN=

# Authentik base URL (container network)
HIVEKEEPER_AUTHENTIK_BASE_URL=http://authentik-server:9000

# OIDC issuer (browser-facing URL)
HIVEKEEPER_OIDC_ISSUER=http://localhost:9000/application/o/hivekeeper/

# OIDC JWKS URI (container network)
HIVEKEEPER_OIDC_JWK_SET_URI=http://authentik-server:9000/application/o/hivekeeper/jwks/

# OIDC client ID
HIVEKEEPER_OIDC_CLIENT_ID=hive-gateway

# OIDC audience
HIVEKEEPER_OIDC_AUDIENCE=hive-gateway

# Console URL (for Authentik redirect URIs)
HIVEKEEPER_CONSOLE_URL=http://localhost:3000

# Application name in Authentik
HIVEKEEPER_APP_NAME=hivekeeper

# ============================================
# Production Notes
# ============================================
# 
# For production:
# 1. Generate a strong AUTHENTIK_SECRET_KEY
# 2. Use strong passwords
# 3. Use HTTPS URLs for issuer and console
# 4. Keep API tokens secret
# 5. Configure proper redirect URIs in Authentik
#
