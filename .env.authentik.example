# Environment for the Authentik stack. Copy to .env and fill in the two values that have no safe default.
#
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml -f docker-compose.authentik.yml up -d --build
#
# ============================================
# Required — no defaults
# ============================================

# ONE token with two jobs: Authentik seeds it as the akadmin API token on first boot, and both the bootstrap
# script and the gateway authenticate with it. Generate one and keep it secret:
#   openssl rand -hex 32
HIVEKEEPER_AUTHENTIK_API_TOKEN=

# Signs Authentik's sessions. Changing it later invalidates every session:
#   openssl rand -hex 32
AUTHENTIK_SECRET_KEY=

# ============================================
# Authentik
# ============================================

# Password for the seeded akadmin account (first boot only). Change it in the admin panel afterwards.
AUTHENTIK_BOOTSTRAP_PASSWORD=admin

# Database password for Authentik's own PostgreSQL.
AUTHENTIK_DB_PASSWORD=authentik

# Host port the Authentik web interface is published on.
HIVEKEEPER_AUTHENTIK_PORT=9000

# ============================================
# HiveKeeper
# ============================================

# Where the browser reaches the console. The bootstrap script registers it as the provider's redirect URI, so
# it must match the URL you actually open — not the container name.
HIVEKEEPER_CONSOLE_URL=http://localhost:8080

# Browser-facing issuer: tokens are minted for the URL the user logs in at, and the gateway checks `iss`
# against it. Change the host here too if you reach Authentik from anywhere but localhost.
HIVEKEEPER_OIDC_ISSUER=http://localhost:9000/application/o/hivekeeper/

# The public client the console uses for auth-code + PKCE, and the audience the gateway requires.
HIVEKEEPER_OIDC_CLIENT_ID=hive-gateway
HIVEKEEPER_OIDC_AUDIENCE=hive-gateway

# ============================================
# Production notes
# ============================================
#
# 1. Generate fresh values for both required secrets above; never ship the examples.
# 2. Serve Authentik and the console over HTTPS and use those URLs here.
# 3. deploy/authentik/bootstrap.sh also runs standalone against an Authentik you already operate — see the
#    header of that script. It needs an API token with permission to manage providers, applications and brands.
# 4. The provider's subject mode must stay "Based on the User's ID" and the brand must keep a recovery flow;
#    docs/authentik.md explains what breaks otherwise.
